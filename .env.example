# ── Walrus Memory ─────────────────────────────────────────────────────────
# Generate both at https://memory.walrus.xyz (mainnet).
# The delegate key is a long-lived credential — treat it like an API key.
MEMWAL_ACCOUNT_ID=
MEMWAL_KEY=

# Set this explicitly so it is obvious which network you are writing to.
#   mainnet  https://relayer.memory.walrus.xyz
#   testnet  https://relayer-staging.memory.walrus.xyz
#
# Credentials are per network: a key generated on one will not authenticate
# against the other.
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Memory space. Recall is scoped to owner + namespace, exact string match.
MEMWAL_NAMESPACE=agent-demo

# Optional. Recall cutoff (cosine distance, lower is closer). Defaults to 0.8,
# which rarely drops a real match but lets the odd stray fact through. 0.7 is
# cleaner when you know how the questions will be phrased.
# MEMWAL_MAX_DISTANCE=0.8

# ── Model ─────────────────────────────────────────────────────────────────
# Optional. Without it the harness runs in echo mode: recall and remember
# still work, the model call is stubbed out.
ANTHROPIC_API_KEY=
